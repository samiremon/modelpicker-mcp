# Optional: public unrestricted models/datasets generally do not need a token.
HF_TOKEN=
MODELPICKER_HOME=~/.modelpicker
MODELPICKER_DATASET_DIR=~/.modelpicker/datasets
MODELPICKER_CPU_THREADS=2
MODELPICKER_MAX_ROWS=1000
MODELPICKER_MAX_IMPORT_ROWS=10000
MODELPICKER_MAX_MODEL_DOWNLOAD_MB=1500
MODELPICKER_MAX_JOB_SECONDS=3600
MODELPICKER_MIN_AVAILABLE_RAM_MB=1024
MODELPICKER_MAX_WORKER_RAM_MB=4096
# Remote only: exact external HTTPS origin, without /mcp.
MODELPICKER_PUBLIC_URL=
# setup generates a private password file; env override is optional.
MODELPICKER_OWNER_PASSWORD=
MODELPICKER_DATASET_URL_HOSTS=raw.githubusercontent.com
